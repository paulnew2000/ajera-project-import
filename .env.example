# Copy this file to ".env" (same folder) and fill in your own values.
# .env is ignored by git - never share it.

# The API URL from Ajera: Company > API Access (it is long and ends in a code after "?")
AJERA_API_URL=https://ajera.com/V000000/AjeraAPI.ashx?PASTE-YOUR-CODE-HERE

# The API user created in Ajera for this purpose (needs CreateProjects allowed)
AJERA_USERNAME=
AJERA_PASSWORD=

# Safety switch. The tool refuses to create anything unless this matches the database your URL
# points at. Run "Check connection" once - it tells you the number to put here.
# Tip: point the URL at your Ajera SANDBOX / test database while you learn.
AJERA_EXPECTED_DB_ID=

# Optional: where the log of created projects is kept (default: created_projects.csv here)
# AJERA_CREATED_LOG=created_projects.csv
